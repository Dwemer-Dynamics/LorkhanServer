#!/usr/bin/env bash
set -u

if [[ -r /etc/lorkhanserver/worker.env ]]; then
    set -a
    # The root-owned environment file contains the runtime database and provider variables.
    source /etc/lorkhanserver/worker.env
    set +a
fi
: "${LORKHAN_CONFIG:=/etc/lorkhanserver/server.php}"
export LORKHAN_CONFIG

child_pid=
stop_worker() {
    if [[ ${child_pid:-} =~ ^[0-9]+$ ]] && kill -0 "${child_pid}" 2>/dev/null; then
        kill "${child_pid}" 2>/dev/null || true
        wait "${child_pid}" 2>/dev/null || true
    fi
    exit 0
}
trap stop_worker TERM INT

while true; do
    /usr/bin/php /var/www/LORKHANserver/current/workers/worker.php &
    child_pid=$!
    status=0
    wait "${child_pid}" || status=$?
    child_pid=
    # Normal bounded exits restart immediately so newly queued dialogue is not held for five seconds.
    if (( status != 0 )); then
        /usr/bin/sleep 1 &
        child_pid=$!
        wait "${child_pid}" || true
        child_pid=
    fi
done
