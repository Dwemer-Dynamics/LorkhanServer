{
  "name": "rangroo/lorkhanserver",
  "description": "Local-first TES3/OpenMW backend for LORKHAN",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-ctype": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "autoload": {
    "classmap": [
      "lib/",
      "processor/",
      "connector/",
      "tts/",
      "stt/",
      "prompts/",
      "service/"
    ]
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "scripts": {
    "lint": "find lib ui conf tests scripts service processor connector tts stt prompts index.php -type f -name '*.php' -exec php -l {} \\;",
    "test": [
      "@php tests/run.php"
    ],
    "test-integration": "scripts/test/integration.sh",
    "test-migrations-jobs": "scripts/test/migrations-jobs.sh",
    "test-cross-repo": "scripts/test/cross-repo-integration.sh",
    "test-beast-http": "scripts/test/beast-http-integration.sh",
    "test-management-http": "scripts/test/management-http-integration.sh"
  }
}
